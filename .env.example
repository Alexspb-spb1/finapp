# Firebase configuration (BASE-002)
#
# Реальные значения НИКОГДА не коммитятся — только в .env.*.local
# (см. .gitignore: *.local) локально, или в GitHub Secrets для CI.
#
# Какой файл использовать:
#   .env.development.local — локальная разработка с Firebase Emulator Suite
#                             (VITE_APP_ENV=development, VITE_USE_FIREBASE_EMULATORS=true,
#                             projectId=demo-finapp — см. scripts/verify-staging-env.mjs
#                             и src/lib/firebaseEnv.ts)
#   .env.staging.local      — сборка `npm run build:staging` против реального
#                             staging Firebase project (VITE_APP_ENV=staging,
#                             projectId=finapp-staging)
#   .env.production.local   — не используется в этом репозитории; production
#                             значения передаются только через GitHub Secrets
#                             в .github/workflows/deploy.yml

# Какое это окружение — влияет на staging-баннер в UI и на проверки в
# src/lib/firebaseEnv.ts. Одно из: development | staging | production
VITE_APP_ENV=development

# Точно "true" включает подключение к локальному Firebase Emulator Suite
# (Auth :9099, Firestore :8080). При true допускается только projectId=demo-finapp.
VITE_USE_FIREBASE_EMULATORS=false

# Firebase Web App config — из Firebase Console → Project settings → Your apps → Web app → Config
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Адреса эмуляторов — используются только при VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ─── Только для реального `npm run build:staging` (BASE-002, независимое ревью) ───
#
# STAGING_FIREBASE_CONFIG_FINGERPRINT
#
# НЕ переменная Vite — намеренно БЕЗ префикса VITE_, чтобы Vite никогда не
# мог включить её в клиентский bundle (Vite экспонирует import.meta.env
# только для VITE_*-переменных). Читается исключительно
# scripts/verify-staging-env.mjs (Node, до запуска tsc/vite).
#
# Зачем нужна: проверка только VITE_FIREBASE_PROJECT_ID (выше) НЕ доказывает,
# что VITE_FIREBASE_API_KEY и остальные поля принадлежат утверждённому
# staging-проекту — Firebase apiKey используется Authentication API
# независимо от projectId, и конфигурация с verified staging projectId, но
# apiKey от другого (в т.ч. production) проекта, прошла бы одну лишь
# projectId-проверку. Эта переменная — ожидаемый SHA-256 hex-дайджест
# нормализованного набора (apiKey, authDomain, projectId, storageBucket,
# messagingSenderId, appId) — см. scripts/lib/firebaseConfigFingerprint.mjs.
#
# Без неё `npm run build:staging` против реального .env.staging.local
# завершается BLOCKED. Значение вычисляется владельцем один раз для
# утверждённого staging Web SDK config и хранится:
#   - локально — в .env.staging.local (не в Git, см. .gitignore: *.local);
#   - в CI — как GitHub Secret (без VITE_ префикса — не должен попасть ни в
#     один *.yml шаг, который прокидывает секреты как VITE_*-build-args).
#
# STAGING_FIREBASE_CONFIG_FINGERPRINT=<64-символьный hex SHA-256, не значение, не пример>
