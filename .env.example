# Firebase configuration (BASE-002)
#
# Реальные значения НИКОГДА не коммитятся — только в .env.*.local
# (см. .gitignore: *.local) локально, или в GitHub Secrets для CI.
#
# Какой файл использовать:
#   .env.development.local — локальная разработка с Firebase Emulator Suite
#                             (VITE_APP_ENV=development, VITE_USE_FIREBASE_EMULATORS=true,
#                             projectId=demo-finapp — см. scripts/verify-staging-env.mjs
#                             и src/lib/firebaseEnv.ts)
#   .env.staging.local      — сборка `npm run build:staging` против реального
#                             staging Firebase project (VITE_APP_ENV=staging,
#                             projectId=finapp-staging)
#   .env.production.local   — не используется в этом репозитории; production
#                             значения передаются только через GitHub Secrets
#                             в .github/workflows/deploy.yml

# Какое это окружение — влияет на staging-баннер в UI и на проверки в
# src/lib/firebaseEnv.ts. Одно из: development | staging | production
VITE_APP_ENV=development

# Точно "true" включает подключение к локальному Firebase Emulator Suite
# (Auth :9099, Firestore :8080). При true допускается только projectId=demo-finapp.
VITE_USE_FIREBASE_EMULATORS=false

# Firebase Web App config — из Firebase Console → Project settings → Your apps → Web app → Config
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Адреса эмуляторов — используются только при VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
