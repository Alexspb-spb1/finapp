# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Cloud Functions build output (SEC-003) — generated, not committed
functions/lib

# Firebase local/emulator artifacts (BASE-002) — never commit
.env.local
.env.*.local
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
.firebase/
firebase-export/
emulator-data/
.secret.local
functions/.secret.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Bank/HAR captures — never commit (may contain session tokens)
*.har

# SEC-005 membership backfill — full reports/decisions contain sensitive
# uid/companyId identifiers and must never be committed. --report-path and
# --decisions-file are required to be absolute paths OUTSIDE this repo
# checkout (enforced in scripts/lib/report.ts) — these patterns are
# defense-in-depth only, in case an operator runs the tool from inside the
# repo with a relative/local path by mistake. Does not hide any source code
# or documentation.
*.membership-backfill-report.json
*.membership-backfill-decisions.json
/migration-reports/
