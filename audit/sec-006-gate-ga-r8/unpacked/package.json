{
  "name": "finapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:staging": "node scripts/verify-staging-env.mjs && tsc -b && vite build --mode staging",
    "test:staging-preflight": "node scripts/test-staging-preflight.mjs",
    "test:invitation-inventory": "node scripts/invitationRehearsal/inventory.mjs --self-test",
    "test:functions-api-preflight": "node scripts/invitationRehearsal/apiActivation.mjs --self-test",
    "test:staging-resources": "node scripts/invitationRehearsal/stagingResources.mjs --self-test",
    "test:invitation-deployment-check": "node scripts/invitationRehearsal/deploymentCheck.mjs --self-test",
    "test:invitation-mailbox-discovery": "node scripts/invitationRehearsal/mailboxDiscovery.mjs --self-test",
    "test:invitation-live-acceptance": "node scripts/invitationRehearsal/liveAcceptance.mjs --self-test",
    "test:invitation-live-browser": "node --test --test-isolation=none scripts/invitationRehearsal/liveAcceptanceBrowserSelfTest.mjs",
    "test:invitation-live-executor": "node scripts/invitationRehearsal/liveAcceptanceExecutor.mjs --self-test",
    "test:invitation-live-adapters": "node scripts/invitationRehearsal/liveAcceptanceExecutorAdaptersSelfTest.mjs",
    "test:invitation-live-operations": "node scripts/invitationRehearsal/liveAcceptanceExecutorOperationsSelfTest.mjs",
    "test:invitation-live-runtime": "node scripts/invitationRehearsal/liveAcceptanceExecutorRuntimeSelfTest.mjs",
    "test:invitation-live-token-lifecycle": "node scripts/invitationRehearsal/liveAcceptanceTokenLifecycleSelfTest.mjs",
    "test:invitation-auth-template-discovery": "node scripts/invitationRehearsal/authVerificationShapeDiscoverySelfTest.mjs",
    "test:invitation-live-playwright": "node scripts/invitationRehearsal/liveAcceptancePlaywrightSelfTest.mjs",
    "test:invitation-live-loopback": "node scripts/invitationRehearsal/liveAcceptanceLoopbackSelfTest.mjs",
    "test:invitation-run-id-guard": "node scripts/invitationRehearsal/liveAcceptanceRunIdSelfTest.mjs",
    "test:invitation-cleanup": "node scripts/invitationRehearsal/liveAcceptanceCleanupSelfTest.mjs",
    "test:invitation-legacy-residual": "node scripts/invitationRehearsal/stage8LegacyResidualSelfTest.mjs",
    "test:invitation-gate-ga-mutations": "node scripts/invitationRehearsal/gateGaMutationChecks.mjs",
    "test:invitation-gate-ga-recipient": "node scripts/invitationRehearsal/gateGaRecipientSelfTest.mjs",
    "test:invitation-gate-ga-negatives": "node scripts/invitationRehearsal/gateGaAdditionalNegativeSelfTest.mjs",
    "test:invitation-gate-ga-orchestrator": "node scripts/invitationRehearsal/gateGaOrchestratorSelfTest.mjs",
    "test:invitation-gate-ga-orchestrator-mutations": "node scripts/invitationRehearsal/gateGaOrchestratorMutationChecks.mjs",
    "test:invitation-gate-ga-staging-cli": "node scripts/invitationRehearsal/gateGaStagingCliSelfTest.mjs",
    "test:invitation-gate-ga-email-verification": "node scripts/invitationRehearsal/gateGaEmailVerificationSelfTest.mjs",
    "test:invitation-gate-ga-run-manifest": "node scripts/invitationRehearsal/gateGaRunManifestSelfTest.mjs",
    "test:invitation-gate-ga-resume-kill": "node scripts/invitationRehearsal/gateGaResumeKillTest.mjs",
    "test:invitation-gate-ga-private-dir-acl": "node scripts/invitationRehearsal/gateGaPrivateDirAclSelfTest.mjs",
    "test:invitation-gate-ga-crash-windows": "node scripts/invitationRehearsal/gateGaCrashWindowsCliTest.mjs",
    "test:invitation-gate-ga-durable-journal": "node scripts/invitationRehearsal/gateGaDurableJournalSelfTest.mjs",
    "test:release-artifact-preflight": "node --test --test-isolation=none scripts/invitationRehearsal/releaseArtifactSelfTest.mjs",
    "test:unit": "vitest run src",
    "lint": "eslint .",
    "preview": "vite preview",
    "firebase:emulators": "firebase emulators:start --project demo-finapp",
    "test:rules": "firebase emulators:exec --project demo-finapp --only firestore \"vitest run tests/rules\"",
    "test:migration": "firebase emulators:exec --project demo-finapp --only firestore \"vitest run scripts --no-file-parallelism\"",
    "typecheck": "tsc -b --pretty false",
    "baseline:bundle": "node scripts/technicalBaseline/report-bundle.mjs",
    "migrate:memberships": "node scripts/backfill-memberships.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^12.14.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "15.24.0",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
