rules_version = '2';

// STAGING / EMULATOR BASELINE ONLY.
// Это НЕ копия и НЕ подтверждение фактических production Firestore Rules —
// те до сих пор не получены и не проверены (см. BASE-004, ещё не выполнена).
// Единственная цель этого файла — дать Firestore Emulator Suite стартовать
// локально (BASE-002) с безопасным deny-all по умолчанию.
// Этот файл НЕ разворачивался (`firebase deploy`) ни в staging, ни в production.
// Полноценная ролевая модель — предмет SEC-011.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
